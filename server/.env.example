# ── SIM Station — server configuration ────────────────────────
# Copy this file to `.env` and adjust. Every value has a safe default.

# Serial baud rate to the Arduino.
BAUD_RATE=115200

# HTTP server port (serves the API and, in production, the built client).
PORT=3001

# Allowed browser origin for CORS. Only needed when running the client dev
# server (`npm run dev`). In production the server serves the client from the
# same origin. If you expose the dashboard through a tunnel, put its URL here.
CLIENT_ORIGIN=http://localhost:5173

# Dashboard password.
#   - Empty  → no authentication (LOCAL USE ONLY).
#   - Set a long random value BEFORE exposing the dashboard to the internet.
AUTH_PASSWORD=

# ── Call transcription (optional) ─────────────────────────────
# Live speech-to-text of the call audio.
#   - Leave WHISPER_CLI_PATH empty → the client falls back to an in-browser
#     Vosk model (download it once with `npm run download-vosk-model`).
#   - Set both paths to use whisper.cpp on the server (better accuracy).
# Get a whisper-cli build + a ggml model from
#   https://github.com/ggerganov/whisper.cpp/releases
WHISPER_CLI_PATH=
WHISPER_MODEL_PATH=
WHISPER_LANG=fr
